# OpenRouter - Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Humanizer model fallback chain (comma-separated, tried in order, first success wins).
# Leave empty to use the default chain defined in backend/app/services/llm_humanizer.py.
HUMANIZE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Cloudflare Tunnel - Leave empty for local development
CLOUDFLARE_TUNNEL_TOKEN=

# App Config
RATE_LIMIT_PER_DAY=3
MAX_TEXT_LENGTH=10000
ADMIN_SECRET=change-me-to-random-string
# Secret salt for pseudonymizing IPs in analytics (HMAC-SHA256). Generate with: openssl rand -hex 32
# If empty, analytics stores no identifier (ip='na'). Do not change it later: distinct-IP counts would split.
IP_HASH_SALT=

# Domain
DOMAIN=localhost
